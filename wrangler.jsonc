{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eslaaaaaaaaaam-3237",
  "main": "packages/web/cloudflare/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "MIDWAY_ALLOW_SETUP": "true",
    "MIDWAY_SECURE_COOKIES": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midway-workspace",
      "database_id": "6d1f50a4-d9d0-4236-bbff-e33602e8bab0",
      "migrations_dir": "cloudflare/migrations",
    },
  ],
}
